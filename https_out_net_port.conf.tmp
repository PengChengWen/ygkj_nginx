
server {
	listen 17441 ssl http2;
	listen  [::]:17441 ssl http2;
	ssi on;
	server_name localhost;
	
	#ssl                  on;
	ssl_certificate      /opt/SJRJ/InG/etc/pki/tls/certs/localhost.crt;
	ssl_certificate_key  /opt/SJRJ/InG/etc/pki/tls/private/localhost.key;
	ssl_dhparam /opt/SJRJ/InG/etc/pki/tls/certs/dhparams.pem;
	
	root /opt/SJRJ/InG/var/www/html;
	index asm_index_redirect.php index.php index.html index.htm;

	ssl_session_cache   shared:SSL:20m;
    ssl_session_timeout 10m;	
	ssl_protocols TLSv1 TLSv1.1 TLSv1.2;
	ssl_ciphers  HIGH:!aNULL:!MD5;
	ssl_prefer_server_ciphers   on;
		

	client_body_temp_path  /opt/SJRJ/InG/tmp/logs/nginx 1 2;
	error_page 404  =200 /;
    
    rewrite_by_lua_block {
        ifztp.access_header_setflag()
    }

	location = /frontend_status {
        charset gbk;
        include /opt/SJRJ/InG/etc/nginx/common/phpfpm.conf;
    }
	
	location ~ /download/getip.php{
        charset gbk;
		echo IP:$remote_addr;
		break;
	}

	location = /reloaduptime{
        redis2_query auth InfogoAsmPass168;
     		default_type text/plain;
     		redis2_query hset dasmreport $arg_ip $arg_time;
     		redis2_pass 127.0.0.1:6379;
    	}

	location ^~ /vendor {
                charset gbk;
                deny all;
                return 403;
        }

	location ~* /composer\.(json|lock)$ {
            charset gbk;
			deny all;
			return 403;
	}
	
	include /opt/SJRJ/InG/etc/nginx/module/access.conf;
	include /opt/SJRJ/InG/etc/nginx/module/compatible.conf;
	include /opt/SJRJ/InG/etc/nginx/module/ztpwss.conf;
	include /opt/SJRJ/InG/etc/nginx/module/outnet.conf;
	
	location ~ \.(php)?$ {
        	deny all;
		return 403;
	}


	location ~ .*\.(gif|jpg|jpeg|png|bmp|swf)$
	{
        charset gbk;
		expires      30d;
	}

	location ~ .*\.(js|css)?$
	{
        charset gbk;
		expires      12h;
	}

	location ~ ^(?!/download/)(.*)\.(tgz|conf)$
	{
		charset gbk;
        set $forbid_flag 0;
		if ($remote_addr ~ (127.0.0.1|^191.*))
		{
			set $forbid_flag "${forbid_flag}1";
		}
		if ($http_user_agent ~* 'wget')
		{
			set $forbid_flag "${forbid_flag}1";
		}
		if ($http_referer ~ ^$)
		{
			set $forbid_flag "${forbid_flag}2";
		}
		if ($forbid_flag = "02")
		{
			return 404;
		}
	}

}
