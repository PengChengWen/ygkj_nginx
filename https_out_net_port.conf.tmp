
server {
	listen 17441 ssl http2;
	listen  [::]:17441 ssl http2;
	ssi on;
	server_name localhost;

	#ssl                  on;
	ssl_certificate      /opt/SJRJ/InG/etc/pki/tls/certs/localhost.crt;
	ssl_certificate_key  /opt/SJRJ/InG/etc/pki/tls/private/localhost.key;
	ssl_dhparam /opt/SJRJ/InG/etc/pki/tls/certs/dhparams.pem;

	root /opt/SJRJ/InG/var/www/html;
	index asm_index_redirect.php index.php index.html index.htm;

	ssl_session_cache   shared:SSL:20m;
    ssl_session_timeout 10m;
	ssl_protocols TLSv1.2;
	ssl_ciphers  HIGH:!aNULL:!MD5:!RSA;
	ssl_prefer_server_ciphers   on;


	client_body_temp_path  /opt/SJRJ/InG/tmp/logs/nginx 1 2;
	error_page 404  =200 /;

    rewrite_by_lua_block {
        ifztp.access_header_setflag()
    }

	include /opt/SJRJ/InG/etc/nginx/module/access.conf;
	include /opt/SJRJ/InG/etc/nginx/module/compatible.conf;
	include /opt/SJRJ/InG/etc/nginx/module/ztpwss.conf;
	include /opt/SJRJ/InG/etc/nginx/module/outnet.conf;
}
